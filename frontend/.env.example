# =====================================================================
# DocuFlow AI - Frontend environment variables
# Copy this file to ".env" only if you want to change the defaults.
# =====================================================================

# Leave EMPTY in development: requests to /api/* are proxied to the
# backend on port 8001 by vite.config.js (no CORS issues).
#
# Set a full URL only when the backend runs on another origin, e.g.
#   VITE_API_URL=http://localhost:8001
VITE_API_URL=

# Port used by `npm run dev`
VITE_PORT=5173
