# =====================================================================
# DocuFlow AI - example environment file
#
# HOW TO USE
#   1. copy this file to `.env`   (cp .env.example .env)
#   2. change the values below
#   3. run `docker compose up --build`
#
# `.env` is git-ignored - only this example is committed, so real
# secrets can never leak into the repository.
#
# For LOCAL DEVELOPMENT (running uvicorn/npm by hand) you do not need
# this file at all: the backend has safe defaults in app/core/config.py
# (SQLite + Mock AI on port 8001).
# =====================================================================

# --- Security -------------------------------------------------------
# JWT signing key. CHANGE THIS before any real deployment.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string

# JWT lifetime in minutes (default 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database -------------------------------------------------------
# Used by docker-compose to build the PostgreSQL connection string.
POSTGRES_PASSWORD=docuflow_dev_password

# --- AI provider ----------------------------------------------------
# true  -> deterministic local Mock engine (no key, no cost, default)
# false -> real providers in AI_PROVIDER_PRIORITY order
MOCK_AI=true

# --- Provider priority & reliability -------------------------------
# Fallback happens ONLY on transient errors (429/quota/5xx/connection/
# timeout/auth/invalid response) - never on invalid input. Mock is
# never added silently when MOCK_AI=false.
AI_PROVIDER_PRIORITY=gemini,openrouter,ollama
AI_MAX_RETRIES=2
AI_REQUEST_TIMEOUT=60
AI_FALLBACK_ENABLED=true

# --- Google Gemini (primary cloud AI) ------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- OpenRouter (cloud fallback) -----------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=                 # e.g. meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FALLBACK_MODELS=       # comma-separated backup ids
OPENROUTER_FREE_MODELS_ONLY=true  # never silently use a paid model
OPENROUTER_ALLOWED_MODELS=        # optional explicit allowlist (wins over :free)
OPENROUTER_MAX_SPEND=0            # USD monthly cap; 0 = no limit

# --- Ollama (optional local inference) -----------------------------
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://host.docker.internal:11434   # or http://ollama:11434
OLLAMA_MODEL=                     # e.g. qwen2.5:1.5b

# --- Embeddings (independent from generation providers) ------------
# auto | gemini | local | mock   (auto = gemini -> local -> mock)
EMBEDDING_PROVIDER=auto
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Misc -----------------------------------------------------------
APP_VERSION=1.0.0
