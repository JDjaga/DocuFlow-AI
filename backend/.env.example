# =====================================================================
# DocuFlow AI - backend environment example
#
#   cp .env.example .env      (then edit the values)
#
# Every value below has a safe default in app/core/config.py, so this
# file is OPTIONAL for local development - create it when you want to
# change something. `.env` is git-ignored and never committed.
# =====================================================================

# --- Security -------------------------------------------------------
# Signs the JWT. Change this before deploying anywhere real.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-secret-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database -------------------------------------------------------
# Local default: SQLite file next to this folder.
#   DATABASE_URL=sqlite:///./docuflow.db
# Docker/Compose injects PostgreSQL automatically instead.
# DATABASE_URL=sqlite:///./docuflow.db

# =====================================================================
# AI - multi-provider configuration (Gemini -> OpenRouter -> Ollama)
# =====================================================================

# true  -> deterministic Mock engine ONLY: no API key, no cost, offline
#          (development, tests, CI - answers are labelled "mock")
# false -> real providers in AI_PROVIDER_PRIORITY order
#          (Mock is NEVER added silently as a fallback)
MOCK_AI=true

# --- Provider priority & reliability --------------------------------
# Order matters: first CONFIGURED provider is primary, the rest are
# automatic fallbacks (only on transient errors: 429/quota/5xx/
# connection/timeout/auth/invalid response - never on bad input).
AI_PROVIDER_PRIORITY=gemini,openrouter,ollama
AI_MAX_RETRIES=2              # per provider, exponential backoff
AI_REQUEST_TIMEOUT=60         # seconds, per provider attempt
AI_FALLBACK_ENABLED=true      # false = first provider only, no fallback

# --- Google Gemini (primary cloud AI) -------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- OpenRouter (cloud fallback) ------------------------------------
OPENROUTER_API_KEY=
# Free model id, e.g. meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL=
# Optional comma-separated backup model ids, tried in order.
OPENROUTER_FALLBACK_MODELS=
# COST GUARD (default true): only allowlisted or ":free" ids may be
# used. A paid model is NEVER picked silently - if every configured
# model is excluded, OpenRouter is skipped and the next provider runs.
OPENROUTER_FREE_MODELS_ONLY=true
# Optional explicit allowlist (comma-separated). Wins over the ":free"
# rule when set, e.g. meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_ALLOWED_MODELS=
# Hard monthly spend cap in USD. 0 = no limit (default, zero extra
# API calls). When > 0, usage is checked (cached 60s) before requests.
OPENROUTER_MAX_SPEND=0

# --- Ollama (optional LOCAL inference) ------------------------------
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
# e.g. qwen2.5:1.5b or llama3.2:1b  (pull it first: ollama pull <model>)
OLLAMA_MODEL=

# --- Embeddings (independent from generation providers) -------------
# auto   -> Gemini when GEMINI_API_KEY is set, else the local model if
#           sentence-transformers is installed, else deterministic mock
# gemini -> GEMINI_EMBEDDING_MODEL via google-genai
# local  -> sentence-transformers/all-MiniLM-L6-v2 (offline, optional)
# mock   -> deterministic hash vectors (dev/tests/CI, simulated)
EMBEDDING_PROVIDER=auto
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Limits ---------------------------------------------------------
MAX_INPUT_CHARS=40000

# --- Uploads --------------------------------------------------------
MAX_FILE_SIZE_MB=10

# --- CORS -----------------------------------------------------------
# Comma-separated allow-list. In development the Vite proxy makes this
# unnecessary (same origin), so you rarely need to touch it.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

APP_VERSION=1.0.0
